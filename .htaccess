# Seul le point d'entrée action.php est accessible depuis le web :
# la configuration (clé privée RSA), les classes et les sessions restent privées.
Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
    <Files "action.php">
        Require all granted
    </Files>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <Files "action.php">
        Allow from all
    </Files>
</IfModule>
