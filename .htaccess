# Portail FFS2play — à utiliser seulement si l'hébergeur ne permet pas de faire pointer
# le domaine sur le dossier public/ (configuration recommandée).
# Tout est réécrit vers public/ ; le code, la configuration (clé privée RSA) et les données restent inaccessibles.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(src|config|templates|database|tests|bin|storage|docker)(/|$) - [F,L]
    RewriteRule ^(\.git|\.github)(/|$) - [F,L]
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    # sans réécriture d'URL, rien n'est servi depuis la racine : faites pointer le domaine sur public/
    Require all denied
</IfModule>
